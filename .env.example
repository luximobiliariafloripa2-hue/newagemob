# AGEMOB — variáveis de ambiente
# IMPORTANTE: segredos reais nunca devem ser commitados neste arquivo — use apenas placeholders.
# Em produção, configure os valores reais diretamente nas variáveis de ambiente do Render.

# Obrigatório: "development" para execução local, "production" no ambiente de
# produção (Render). Qualquer outro valor, ou ausência, impede o startup.
NODE_ENV=development

PORT=3000
BASE_URL=

# JWT_SECRET é obrigatório em produção. Gere uma string longa e aleatória.
JWT_SECRET=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=

BREVO_API_KEY=
BREVO_SENDER=

STORAGE_DIR=
DATA_DIR=

DOSSIE_SIGNING_PRIVATE_KEY=

# Opcional. Chaves públicas Ed25519 históricas/confiáveis (SPKI PEM, blocos
# BEGIN PUBLIC KEY) aceitas na verificação do Dossiê. A chave derivada de
# DOSSIE_SIGNING_PRIVATE_KEY já entra automaticamente.
DOSSIE_TRUSTED_PUBLIC_KEYS=

# Carimbo de tempo RFC 3161 do Dossiê. TSA_URL e TSA_TRUSTED_ROOTS são
# obrigatórias juntas (obrigatórias em produção). TSA_TRUSTED_ROOTS é o
# caminho de um arquivo PEM com a raiz (e intermediárias) da TSA.
# TSA_USERNAME/TSA_PASSWORD só se o provedor exigir Basic Auth.
# TSA_POLICY_OID só se o provedor exigir política. TSA_TIMEOUT_MS padrão: 10000.
TSA_URL=
TSA_TRUSTED_ROOTS=
TSA_USERNAME=
TSA_PASSWORD=
TSA_POLICY_OID=
TSA_TIMEOUT_MS=

# Gateway de pagamento InfinitePay (checkout por link). Obrigatórias em
# produção: sem elas o servidor não sobe. INFINITEPAY_API_KEY é a API Key
# (inchk_...) gerada na conta; nunca vai ao navegador. INFINITEPAY_HANDLE é a
# InfiniteTag da conta, sem o "$".
INFINITEPAY_API_KEY=
INFINITEPAY_HANDLE=
# Somente development/test: URL de um servidor fake da API. Em produção a
# presença desta variável impede o startup (a URL oficial é fixa).
INFINITEPAY_API_URL=
# EXCLUSIVO PARA HOMOLOGAÇÃO. Somente o valor exato "true" desliga o gateway:
# credenciais deixam de ser exigidas, nenhuma chamada à InfinitePay é feita e
# checkout/webhook respondem 503 (sem pedidos, sem ativação de plano). Vazio
# ou "false" mantém o comportamento normal; outro valor impede o startup.
# NUNCA usar no lançamento comercial — remover e configurar as credenciais.
INFINITEPAY_DESATIVADO=

# Contato comercial do plano Corporate na landing. Aceita https://… (inclusive
# https://wa.me/…) ou mailto:…. Vazio ou inválido: "Contato comercial em breve".
CORPORATE_CONTACT_URL=
